# Normalize everything to LF — in the repo and on checkout, on every platform.
* text=auto eol=lf

# Rust / config / docs are always text.
*.rs   text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.sh   text eol=lf

# Binaries — never normalize.
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
